<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent do painel do Translunar no server: ~/Library/LaunchAgents/local.translunar-painel.plist -->
<plist version="1.0"><dict>
  <key>Label</key>             <string>local.translunar-painel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/server/apps/translunar/.venv/bin/legendar</string><string>painel</string>
  </array>
  <key>WorkingDirectory</key>  <string>/Users/server/apps/translunar</string>
  <key>RunAtLoad</key>         <true/>
  <key>KeepAlive</key>         <true/>
  <key>StandardOutPath</key>   <string>/Users/server/logs/translunar-painel.log</string>
  <key>StandardErrorPath</key> <string>/Users/server/logs/translunar-painel.err</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
</dict></plist>
